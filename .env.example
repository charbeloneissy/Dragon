# Binance connection
BINANCE_API_BASE=https://api.binance.com
BINANCE_WS_BASE=wss://stream.binance.com:9443/ws
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Runtime mode
DRY_RUN=true
LIVE_TRADING=false

# Arbitrage economics
MIN_NET_EDGE_BPS=0.5
MAX_NOTIONAL_USDT=25
MAX_SLIPPAGE_BPS=10
FEE_BPS=10
ARB_RISK_PCT=0.01

# Runtime controls
LIVE_ORDER_COOLDOWN_MS=1000
ORDER_TIMEOUT_MS=5000
STALE_MS=750
DEPTH_LEVELS=20
MAX_TRIANGLES=5000
POLL_INTERVAL_SECONDS=0.02
LEDGER_PATH=/tmp/dragon_ledger.sqlite3
