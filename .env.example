# Dragon — multi-chain cross-DEX arbitrage (paper mode by default)
DRY_RUN=true
LIVE_TRADING=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Chains and venues
# ---------------------------------------------------------------------------
# Comma-separated EVM chain ids to scan. Defaults to Base only.
# Supported: 1 ethereum, 10 optimism, 56 bnb, 130 unichain, 137 polygon,
#            324 zksync, 480 worldchain, 5000 mantle, 8453 base, 42161 arbitrum,
#            42220 celo, 43114 avalanche, 59144 linea.
DEX_CHAINS=8453

# Comma-separated non-EVM chain families to scan (tron, cosmos, aptos).
NONEVM_CHAINS=

# Per-chain RPC. If unset, a public fallback RPC is used automatically.
# Set these to a private/paid endpoint for production throughput.
DEX_RPC_URL=
DEX_RPC_URLS=
ETHEREUM_RPC_URL=
ETHEREUM_RPC_URLS=
OPTIMISM_RPC_URL=
OPTIMISM_RPC_URLS=
BNB_RPC_URL=
BNB_RPC_URLS=
UNICHAIN_RPC_URL=
UNICHAIN_RPC_URLS=
POLYGON_RPC_URL=
POLYGON_RPC_URLS=
ZKSYNC_RPC_URL=
ZKSYNC_RPC_URLS=
WORLDCHAIN_RPC_URL=
WORLDCHAIN_RPC_URLS=
MANTLE_RPC_URL=
MANTLE_RPC_URLS=
ARBITRUM_RPC_URL=
ARBITRUM_RPC_URLS=
CELO_RPC_URL=
CELO_RPC_URLS=
AVALANCHE_RPC_URL=
AVALANCHE_RPC_URLS=
LINEA_RPC_URL=
LINEA_RPC_URLS=
SOLANA_RPC_URL=
NONEVM_TRON_RPC_URL=
NONEVM_COSMOS_LCD_URL=https://lcd.osmosis.zone
NONEVM_APTOS_RPC_URL=https://fullnode.mainnet.aptoslabs.com/v1

# Optional venue selection override. Defaults to every venue on each chain.
DEX_SOURCES=
# Override the stablecoin quote token per chain: "8453:0x...:6,1:0x...:6".
DEX_QUOTE_TOKENS=
# Override the base-token universe for every enabled EVM chain.
DEX_PAPER_BASE_TOKENS=

# Astroport (Cosmos) is disabled until per-chain routers are configured.
ASTROPORT_NEUTRON_ROUTER=
ASTROPORT_SEI_ROUTER=

# ---------------------------------------------------------------------------
# Strategy
# ---------------------------------------------------------------------------
DEX_TAKER_ADDRESS=
DEX_FLASH_LOAN_LIQUIDITY_QUOTE=1000
DEX_MIN_NET_PROFIT=0.005
DEX_SAFETY_BUFFER=0.001
DEX_SLIPPAGE_BPS=50
DEX_POLL_SECONDS=2.0
DEX_MAX_OPPORTUNITIES=8

# ---------------------------------------------------------------------------
# Execution (live trading stays disabled by default)
# ---------------------------------------------------------------------------
DEX_EXECUTOR_ADDRESS=
DEX_EXECUTOR_OWNER_ADDRESS=
DEX_EXECUTOR_OWNER_PRIVATE_KEY=
DEX_PRIVATE_RPC_URL=
FLASH_LOAN_ENABLED=false
FLASH_LOAN_FEE_BPS=0
MEV_PROTECTION_REQUIRED=true
ATOMIC_REPAYMENT_REQUIRED=true
