# Dragon — multi-chain cross-DEX arbitrage (paper mode by default)
DRY_RUN=true
LIVE_TRADING=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Chains and venues
# ---------------------------------------------------------------------------
# Comma-separated EVM chain ids to scan. Defaults to Base only.
# Supported: 1 ethereum, 10 optimism, 56 bnb, 130 unichain, 137 polygon,
#            324 zksync, 480 worldchain, 5000 mantle, 8453 base, 42161 arbitrum,
#            42220 celo, 43114 avalanche, 59144 linea, 534352 scroll, 84532 base-sepolia.
DEX_CHAINS=42220,56,8453
# Optional comma-separated filter for the 48 requested chain/native-coin
# watchlist. Blank means include the complete screenshot-derived universe.
UNIVERSE_CHAINS=

# Comma-separated non-EVM chain families to scan (tron, cosmos, aptos, solana).
NONEVM_CHAINS=

# Per-chain RPC. If unset, a public fallback RPC is used automatically.
# Set these to a private/paid endpoint for production throughput.
#
# Private RPC providers (optional but recommended). When a key is present the
# engine prefers these authenticated endpoints per chain and only falls back to
# the public RPC during failures.
#   Alchemy  : ALCHEMY_API_KEY   (covers eth/arb/opt/polygon/base/avax/bnb/linea/zksync/scroll/blast)
#   Infura   : INFURA_API_KEY    (or INFURA_PROJECT_ID)
#   QuickNode: QUICKNODE_API_KEY + QUICKNODE_ENDPOINT + QUICKNODE_CHAIN_ID
# A single QUICKNODE_ENDPOINT host serves one chain, so also set
# QUICKNODE_CHAIN_ID, or use per-chain QUICKNODE_<CHAIN>_URL for more chains.
# Per-chain provider overrides: ALCHEMY_<CHAIN>_URL / INFURA_<CHAIN>_URL / QUICKNODE_<CHAIN>_URL.
# Explicit <CHAIN>_RPC_URL / <CHAIN>_RPC_URLS always wins over any provider.
ALCHEMY_API_KEY=
INFURA_API_KEY=
QUICKNODE_API_KEY=
QUICKNODE_ENDPOINT=
QUICKNODE_CHAIN_ID=

DEX_RPC_URL=
DEX_RPC_URLS=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_RPC_URLS=https://sepolia.base.org
ETHEREUM_RPC_URL=
ETHEREUM_RPC_URLS=
OPTIMISM_RPC_URL=
OPTIMISM_RPC_URLS=
BNB_RPC_URL=
BNB_RPC_URLS=
UNICHAIN_RPC_URL=
UNICHAIN_RPC_URLS=
POLYGON_RPC_URL=
POLYGON_RPC_URLS=
ZKSYNC_RPC_URL=
ZKSYNC_RPC_URLS=
WORLDCHAIN_RPC_URL=
WORLDCHAIN_RPC_URLS=
MANTLE_RPC_URL=
MANTLE_RPC_URLS=
ARBITRUM_RPC_URL=
ARBITRUM_RPC_URLS=
CELO_RPC_URL=
CELO_RPC_URLS=
AVALANCHE_RPC_URL=
AVALANCHE_RPC_URLS=
LINEA_RPC_URL=
LINEA_RPC_URLS=
SCROLL_RPC_URL=
SCROLL_RPC_URLS=
SOLANA_RPC_URL=
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/
HELIUS_API_URL=https://api.helius.xyz
HELIUS_TIMEOUT_SECONDS=8
HELIUS_REFRESH_SECONDS=5
JUPITER_API_KEY=
JUPITER_QUOTE_URL=https://api.jup.ag/swap/v1/quote
NONEVM_TRON_RPC_URL=
NONEVM_COSMOS_LCD_URL=https://lcd.osmosis.zone
NONEVM_APTOS_RPC_URL=https://fullnode.mainnet.aptoslabs.com/v1

# Optional venue selection override. Defaults to every venue on each chain.
DEX_SOURCES=
# Override the stablecoin quote token per chain: "8453:0x...:6,1:0x...:6".
DEX_QUOTE_TOKENS=
# Override the base-token universe for every enabled EVM chain.
DEX_PAPER_BASE_TOKENS=

# Astroport (Cosmos) is disabled until per-chain routers are configured.
ASTROPORT_NEUTRON_ROUTER=
ASTROPORT_SEI_ROUTER=

# ---------------------------------------------------------------------------
# Strategy
# ---------------------------------------------------------------------------
DEX_TAKER_ADDRESS=
DEX_FLASH_LOAN_LIQUIDITY_QUOTE=1000
DEX_MIN_NET_PROFIT=0.002
DEX_SAFETY_BUFFER=0
DEX_SLIPPAGE_BPS=50
DEX_POLL_SECONDS=0.5
DEX_MAX_OPPORTUNITIES=8
TRIANGULAR_ARBITRAGE_ENABLED=true
# Operator-verified 3-token cycles: chainId:tokenA:tokenB:tokenC (no guessed addresses)
DEX_TRIANGULAR_TOKENS=
DEX_DYNAMIC_PROFIT_CURVE=true
DEX_MAX_LEG_WORKERS=24
DEX_MAX_EXECUTION_CONCURRENCY=64
DEX_EXECUTION_HISTORY_SIZE=2048
DEX_GAS_ROLLING_WINDOW=256
GAS_SPONSOR_ENABLED=true
GAS_SPONSOR_REQUIRED=false
GAS_SPONSOR_MAX_FEE_QUOTE=0
GAS_SPONSOR_ENDPOINT=
GAS_SPONSOR_API_KEY=

# ---------------------------------------------------------------------------
# Execution (live trading stays disabled by default)
# ---------------------------------------------------------------------------
# Aave V3 flash liquidity / Dragon atomic executor.
# Set the per-chain Pool address when enabling flash liquidity.
# Do not use the Aave Dashboard "Borrow" flow for Dragon.
DEX_AAVE_POOL_ADDRESS=
DEX_AAVE_POOL_1=
DEX_AAVE_POOL_10=
DEX_AAVE_POOL_56=
DEX_AAVE_POOL_137=
DEX_AAVE_POOL_8453=
DEX_AAVE_POOL_42161=
DEX_AAVE_POOL_43114=
DEX_EXECUTOR_ADDRESS=
DEX_EXECUTOR_OWNER_ADDRESS=
DEX_EXECUTOR_OWNER_PRIVATE_KEY=
DEX_PRIVATE_RPC_URL=
FLASH_LOAN_ENABLED=false
FLASH_LOAN_FEE_BPS=0
MEV_PROTECTION_REQUIRED=true
ATOMIC_REPAYMENT_REQUIRED=true

# ---------------------------------------------------------------------------
# Aave MCP (read-only V3/V4 market and yield telemetry)
# ---------------------------------------------------------------------------
# Official shared endpoint. No key is currently required.
AAVE_MCP_URL=https://mcp.aave.com
AAVE_MCP_ENABLED=true
AAVE_MCP_TIMEOUT_SECONDS=8
AAVE_MCP_CACHE_SECONDS=60
AAVE_MCP_REFRESH_SECONDS=60
AAVE_MCP_TOP_N=12
AAVE_MCP_STABLECOINS=USDC,USDT,DAI,GHO,USDe,USDS,PYUSD,FRAX,crvUSD

# AaveKit Protocol v4 GraphQL / Arc monitoring
AAVE_V4_GRAPHQL_URL=https://api.v4.aave.com/graphql
AAVE_V4_GRAPHQL_ENABLED=true
AAVE_V4_GRAPHQL_TIMEOUT_SECONDS=8
AAVE_V4_GRAPHQL_REFRESH_SECONDS=60
AAVE_V4_ARC_CHAIN_ID=5042
# Operator-supplied Stable Vault address from the current integration
AAVE_STABLE_VAULT_ADDRESS=0xDA0c6A384E5c10a96ded8759B068aaD9299D184A
AAVE_STABLE_VAULT_CHAIN_ID=5042


# Aave Stable Vault configuration boundary. Leave disabled until the deployed
# Stable Vault contract/address and approved strategy configuration are supplied.
# Dragon only exposes validated telemetry here; it does not auto-deposit,
# rebalance, bridge, withdraw, or sign Stable Vault transactions.
AAVE_STABLE_VAULTS_ENABLED=false
AAVE_STABLE_VAULTS_JSON=

# Aave V4 Hub -> Spoke -> Reserve liquidity telemetry
AAVE_V4_LIQUIDITY_ENABLED=true
AAVE_V4_LIQUIDITY_CHAIN_ID=5042
AAVE_V4_LIQUIDITY_REFRESH_SECONDS=60
