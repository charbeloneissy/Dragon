# Binance connection
BINANCE_API_BASE=https://api.binance.com
BINANCE_WS_BASE=wss://stream.binance.com:9443/ws
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_FUTURES_API_BASE=https://fapi.binance.com

# Runtime mode
DRY_RUN=true
LIVE_TRADING=false

# Spot arbitrage economics
MIN_NET_EDGE_BPS=5
MAX_NOTIONAL_USDT=25
MAX_SLIPPAGE_BPS=10
FEE_BPS=10
ARB_RISK_PCT=0.0015
MIN_TRADE_NOTIONAL_USDT=5

# Optional spot triangle universe exclusions (comma-separated base assets).
# Empty = full universe. Example: EXCLUDED_BASE_ASSETS=BTC,ETH
EXCLUDED_BASE_ASSETS=

# Spot runtime controls
LIVE_ORDER_COOLDOWN_MS=1000
ORDER_TIMEOUT_MS=5000
STALE_MS=750
DEPTH_LEVELS=20
MAX_TRIANGLES=0
STREAM_SYMBOL_CAP=0
POLL_INTERVAL_SECONDS=0.02
LEDGER_PATH=/tmp/dragon_ledger.sqlite3

# USDⓈ-M Futures controls
# Keep disabled in the example. Enable only in the Render production environment
# after the Binance Futures wallet, permissions and IP/rate-limit health are verified.
FUTURES_ENABLED=false
FUTURES_LIVE_TRADING=false
FUTURES_POLL_SECONDS=10
FUTURES_MAX_SYMBOLS=0
FUTURES_MAX_NOTIONAL_USDT=25
FUTURES_ORDER_NOTIONAL_USDT=25
FUTURES_MIN_NET_EDGE_BPS=12
FUTURES_FEE_BPS=5
FUTURES_FUNDING_BUFFER_BPS=3
FUTURES_RISK_PCT=0.0015
